# syntax=docker/dockerfile:1
# Reference registry data-plane image (Task 24).
#
# Multi-stage build using the module's Go version (see go.mod: go 1.25).
# The final image runs as a NON-ROOT numeric user (65532:65532), contains only
# the compiled binary plus the operating-system CA bundle, and exposes the
# documented registry port. No secrets are baked: every credential (master key,
# internal credential, JWKS, internal TLS) is mounted at runtime from the
# compose secrets bind (${SECRETS_DIR}).
#
# The compose reference stack serves the registry on port 80 (REGISTRY_ADDR)
# so the in-network Docker/Podman e2e clients can address the registry host
# portless; the image default and documented port remain 8080.

FROM golang:1.25.13-alpine AS build
WORKDIR /src

# Dependency layer first: changes to go.mod/go.sum invalidate only this layer.
COPY go.mod go.sum ./
RUN go mod download

# Source: only the packages the binaries link against (no scripts/docs/tests).
COPY cmd ./cmd
COPY internal ./internal

# modernc.org/sqlite (the durable staging service) is pure Go: no cgo or
# cross-toolchain needed. -trimpath keeps build paths out of the binary.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/registry ./cmd/registry

FROM alpine:3.24
# Required operating-system certificates for outbound TLS (the control-plane
# CA bundle itself is mounted at runtime). util-linux provides setpriv, which
# the compose entrypoint uses to drop from the secret-staging root to the
# non-root runtime uid. busybox wget ships with alpine and is what the compose
# healthcheck uses. The uncloud user owns the registry's writable home
# (staging spool + SQLite are composed onto it).
RUN apk add --no-cache ca-certificates util-linux \
    && addgroup -g 65532 -S uncloud \
    && adduser -u 65532 -G uncloud -S -h /var/lib/uncloud-registry -s /sbin/nologin uncloud

COPY --from=build /out/registry /usr/local/bin/registry

USER 65532:65532
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/registry"]
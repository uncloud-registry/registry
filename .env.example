# Environment template for the reference deployment (Task 24).
#
# Copy to .env and replace every <...> placeholder. NEVER commit real secrets;
# this file carries placeholders only. The e2e scripts
# (scripts/e2e/compose-smoke.sh, docker-roundtrip.sh) generate real, ephemeral
# secrets automatically and never touch this file.
#
# Required secrets-dir files (mounted read-only from ${SECRETS_DIR}):
#   master.json            control-plane feed-key master, JSON: {"current":1,"keys":{"1":"<unpadded base64url of exactly 32 bytes>"}}
#   internal-secret.txt    registry<->control-plane internal credential, one line of >=32 random bytes, mode 0600
#   internal-ca.pem        CA that signed controlplane-internal-cert.pem
#   internal-cert.pem      TLS certificate for the internal feed-signing listener (SAN: controlplane)
#   internal-key.pem       matching private key, mode 0600
#   registry-jwks.json     JWKS with the public key of CONTROLPLANE_REGISTRY_ED25519_KEY (kid = CONTROLPLANE_REGISTRY_KEY_ID)
#   bee-password.txt       Bee keystore password (one line)
#
# scripts/e2e/lib.sh generates every file above; operators can use it as the
# reference procedure (scripts/e2e/compose-smoke.sh --help documents the flow).

# ---------------------------------------------------------------------------
# Control plane (public)
# ---------------------------------------------------------------------------
CONTROLPLANE_MODE=production
# Public origin the browser/session layer treats as canonical (https in prod).
CONTROLPLANE_EXTERNAL_URL=https://controlplane.example.test
# Registry hostname suffix: every created registry becomes <slug>.<DOMAIN>.
CONTROLPLANE_REGISTRY_DOMAIN=example.test
# Session signing secret: >= 32 random bytes, no repeated patterns.
#   generate: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 43
CONTROLPLANE_TOKEN_SECRET=<generate at least 32 random bytes>
# Ed25519 signing seed for registry tokens (64 hex chars). The public key must
# appear in registry-jwks.json under CONTROLPLANE_REGISTRY_KEY_ID.
#   generate: openssl rand -hex 32
CONTROLPLANE_REGISTRY_ED25519_KEY=<generate a 64-character hex Ed25519 seed>
CONTROLPLANE_REGISTRY_KEY_ID=cp-ed25519-1

# ---------------------------------------------------------------------------
# Registry data plane
# ---------------------------------------------------------------------------
# Public hostname(s) served by the registry data plane and handed to clients.
# One pair per host; values come from the control plane at registry creation
# (GET /api/registries after creating each registry):
#   REGISTRY_OWNER_MAP=<host>=<feedOwnerAddress>,...
#   REGISTRY_ID_MAP=<host>=<registry id>,...
REGISTRY_OWNER_MAP=
REGISTRY_ID_MAP=
# Exact comma-separated host allowlist the registry accepts tokens for.
REGISTRY_TOKEN_AUDIENCE=
# Where Docker/Podman clients fetch bearer tokens (the 401 challenge realm).
#   default: https://controlplane.uncloud-registry.test/token
REGISTRY_AUTH_REALM=
# Set true so `docker push` authenticates (challenge on /v2/). Disables anonymous docker pull.
REGISTRY_PING_CHALLENGE=

# ---------------------------------------------------------------------------
# Routing (Caddy)
# ---------------------------------------------------------------------------
# The created registries are <slug>.<CONTROLPLANE_REGISTRY_DOMAIN>. The glob
# below is the smallest pattern that covers every slug:
REGISTRY_HOST_GLOB=*.example.test
# Control-plane dashboard/token host:
CONTROLPLANE_HOST=controlplane.example.test

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Directory (never committed) that holds the secrets-dir files listed above.
# The e2e scripts point this at a private mktemp directory; production
# operators typically use a dedicated mount.
SECRETS_DIR=./.secrets

# ---------------------------------------------------------------------------
# Real-network deployments (compose.testnet.yaml / compose.mainnet.yaml)
# ---------------------------------------------------------------------------
# Required ONLY for the testnet/mainnet stacks (the local compose.yaml uses the
# built-in localchain and does not read this). A Sepolia RPC for testnet, a
# Gnosis chain RPC for mainnet. Bee derives bootnodes and all contract
# addresses from its built-in network config, so this is the only chain input.
#BEE_BLOCKCHAIN_RPC=

# ---------------------------------------------------------------------------
# Optional tunables (defaults shown)
# ---------------------------------------------------------------------------
#CONTROLPLANE_SESSION_TTL=24h
#REGISTRY_UPLOAD_TTL=24h
#REGISTRY_MAX_UPLOAD_BYTES=2147483648
#REGISTRY_MAX_REPOSITORY_BYTES=26843545600
#REGISTRY_MAX_TOTAL_STAGING_BYTES=53687091200
#REGISTRY_CLEANUP_INTERVAL=5m
#REGISTRY_CLEANUP_BATCH=100
#CONTROLPLANE_TRUSTED_PROXIES=172.29.0.0/16